# ─────────────────────────────────────────────────────────────────────────────
# Supabase Connection Credentials (Required to connect to your Supabase instance)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Local Development Fallback Keys (If not fetched dynamically from Supabase database)
# ─────────────────────────────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=***
# FLUX_API_KEY=sk_flux_...
# OPENAI_API_KEY=sk_openai_...
# KIE_API_KEY=...            # kie.ai key; normally resolved from Supabase api_keys(provider='kie.ai')

# ─────────────────────────────────────────────────────────────────────────────
# OmniCast — URL → promo + explainer video, driven autonomously over MCP.
# EVERY value below has a sensible default in src/lib/runtimeConfig.ts, so an MCP
# tool call can pass only a url (or nothing at all, if OMNICAST_DEFAULT_URL is set).
# ─────────────────────────────────────────────────────────────────────────────

# --- What to make -------------------------------------------------------------
OMNICAST_DEFAULT_URL=                  # blank = the caller must supply a url
OMNICAST_DEFAULT_MODE=promo            # promo | explainer | both
OMNICAST_DEFAULT_TONE=default          # brag preset, or freeform direction e.g. "yc-parody"
OMNICAST_DEFAULT_FORMAT=vertical       # vertical (1080x1920) | landscape (1920x1080) | square
OMNICAST_DEFAULT_DURATION=20           # seconds; brag's 15-25s window is enforced in code
OMNICAST_DEFAULT_STYLE=photo-realistic # ImageStylePreset for generated concept art

# --- Audio --------------------------------------------------------------------
OMNICAST_VOICE=0                       # 1 = ElevenLabs narration (brag: narration is opt-in)
OMNICAST_VOICE_SPEED=0.95
OMNICAST_VOICE_ID=
OMNICAST_MUSIC=1
OMNICAST_MUSIC_TRACK=                  # blank = auto-pick a bundled brag track by tone
OMNICAST_SFX=1
OMNICAST_CAPTIONS=1                    # 1 = burn in word-level captions (needs OMNICAST_VOICE=1)

# --- Real-UI capture (satisfies brag's "show the thing") ----------------------
OMNICAST_CAPTURE=1
OMNICAST_CHROME_PATH=                  # blank = auto-detect Google Chrome
OMNICAST_CAPTURE_TIMEOUT_MS=45000

# --- Claude for the brag creative layer (via kie.ai, NOT full-price Anthropic) --
# Verified live 2026-10-11: claude-opus-5-5 ✅ (~9s warm / ~92s cold), claude-sonnet-5 ✅
# Endpoint: POST https://api.kie.ai/claude/v1/messages
# GOTCHA: kie.ai returns failures as HTTP 200 with {code,msg} — never trust res.ok.
OMNICAST_BRAG_MODEL=claude-opus-5-5
OMNICAST_BRAG_MODEL_FALLBACKS=claude-sonnet-5
OMNICAST_BRAG_MAX_TOKENS=8192
OMNICAST_BRAG_TIMEOUT_MS=240000        # opus cold start measured at ~92s
OMNICAST_BRAG_TEMPERATURE=1

# --- Publishing (YouTube Data API v3, OAuth refresh token) --------------------
OMNICAST_PUBLISH=0                     # 1 = auto-publish after a successful render
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=                 # mint once with: npm run youtube:auth
OMNICAST_YOUTUBE_PRIVACY=unlisted      # private | unlisted | public
YOUTUBE_CATEGORY_ID=28                 # Science & Technology
YOUTUBE_MADE_FOR_KIDS=0
YOUTUBE_DEFAULT_TAGS=ai,automation,tutorial

# --- Paths / performance ------------------------------------------------------
OMNICAST_RUNS_DIR=runs
OMNICAST_BRAG_SKILL_DIR=~/.hermes/skills/brag
OMNICAST_PUBLIC_DIR=public
OMNICAST_CONCURRENCY=1

# ── Storyteller: URL → narrated explainer video (nano-banana-pro + Seedance), unattended ──
STORYTELLER_DEFAULT_URL=            # blank = the caller must supply a url
STORYTELLER_STYLE=infographic       # photo-realistic | illustration | flat-vector | infographic | whiteboard
STORYTELLER_ASPECT=16:9             # 16:9 | 9:16 | 1:1
STORYTELLER_IMAGE_RESOLUTION=2K     # 1K | 2K | 4K (mapped from width; 2K for 1920px)
STORYTELLER_VIDEO_SCENES=1          # 1 = animate image_to_video/text_to_video scenes with Seedance
STORYTELLER_VIDEO_MAX_SCENES=4      # cost guard: each Seedance scene is ~80 credits + up to 20 min queue
STORYTELLER_SCENE_COUNT=0           # 0 = let the LLM/classifier decide
STORYTELLER_RESEARCH=0              # 1 = allow external research during storyboard planning
STORYTELLER_FOCUS_TOPICS=all        # all | "1,3,4" | blank = none
STORYTELLER_REGION_HIGHLIGHTS=0     # 1 = needs the EasyOCR/DINO backend on :8001
STORYTELLER_VOICE=1
STORYTELLER_VOICE_ID=c6SfcYrb2t09NHXiT80T
STORYTELLER_VOICE_SPEED=0.95
STORYTELLER_VOICE_STABILITY=0.5      # 0-1; lower = more expressive/variable delivery
STORYTELLER_VOICE_SIMILARITY=0.75    # 0-1; higher = closer to the original voice
STORYTELLER_TTS_MODEL=eleven_multilingual_v2   # NOT turbo_v2_5 (no audio_base64)
STORYTELLER_CAPTIONS=1              # burned-in word-synced captions (needs voice)
STORYTELLER_MUSIC_TRACK=            # blank = no background music
STORYTELLER_CONCURRENCY=1           # renders are CPU-bound; also protects shared public/ paths
STORYTELLER_RUNS_DIR=runs
STORYTELLER_PUBLIC_DIR=public
STORYTELLER_PUBLISH=0               # publishing is not wired into the first cut
STORYTELLER_VIDEO_MODEL=bytedance/seedance-2-mini      # assertion only; the model comes from Supabase
STORYTELLER_IMAGE_INFOGRAPHIC_MODEL=nano-banana-pro             # ditto
STORYTELLER_IMAGE_REALISTIC_MODEL=flux-2/pro-text-to-image      # ditto
