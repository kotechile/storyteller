{
  "name": "remotion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "^4.0.484",
    "@remotion/google-fonts": "^4.0.484",
    "@remotion/tailwind-v4": "4.0.484",
    "@remotion/zod-types": "^4.0.484",
    "@supabase/supabase-js": "^2.108.2",
    "@types/pdf-parse": "^1.1.5",
    "lucide-react": "^1.34.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "^4.0.484",
    "tailwindcss": "4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/eslint-config-flat": "4.0.484",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web": "0.0.166",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.1.5"
  },
  "scripts": {
    "start": "remotion studio src/index.ts",
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "app": "vite --port 3001 --open /studio.html",
    "generate": "npx tsx src/generateStoryFromUrl.ts",
    "omnicast": "tsx src/omnicast.ts",
    "mcp:serve": "tsx mcp/server.mts",
    "mcp:test": "tsx scripts/test-mcp-server.ts",
    "mcp:test:full": "tsx scripts/test-mcp-server.ts --generate",
    "brag:sync": "node scripts/sync-brag-assets.mjs",
    "brag:seed": "tsx scripts/seed-brag-llm-config.ts",
    "youtube:auth": "tsx scripts/youtube-auth.ts",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:all": "npm run render:title && npm run render:lower && npm run render:kinetic && npm run render:transparent && npm run render:cta",
    "render:title": "remotion render title-card out/title-card.mp4 --codec=h264 --crf=18",
    "render:lower": "remotion render lower-third out/lower-third.mp4 --codec=h264 --crf=18",
    "render:kinetic": "remotion render kinetic-text out/kinetic-text.mp4 --codec=h264 --crf=18",
    "render:transparent": "remotion render transparent-overlay out/transparent-overlay.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:cta": "remotion render call-to-action out/call-to-action.mp4 --codec=h264 --crf=18",
    "render:sequence": "remotion render transparent-overlay out/sequence/frame-%04d.png --image-format=png"
  },
  "sideEffects": [
    "*.css"
  ]
}
